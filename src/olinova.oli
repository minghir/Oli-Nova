config echo off
config max_iterations 0
config win_app 1

plugin oli_opengl
plugin oli_keyboard
plugin oli_math
plugin oli_time
plugin oli_miniaudio 

include "src/Scene.oli"
include "src/Environment.oli"
include "src/OptionsMenu.oli"

SND_INIT()

# Inițializare fereastră (0 = Windowed 800x600 fix)
GL_INIT(800, 600, "Oli-Nova", 0)

@globalMusicId = SND_LOAD("assets/music1.mp3")
SND_SET_LOOPING(@globalMusicId, 1) # Loop infinit muzică
SND_PLAY(@globalMusicId)

@sfxEnabled = 1

$scene = new("Scene")
$scene.init()

$lastTime = TIME()

# ==========================================
# STĂRILE JOCULUI
# ==========================================
$STATE_MENU = 0
$STATE_GAME = 1
$STATE_OPTIONS = 2

$appState = $STATE_MENU
$menuIndex = 0    
$gameStarted = 0      

# Cooldown bazat pe Milisecunde Absolute (TICKS)
$lastKeyPressTime = TICKS()
$inputDelayMs = 200

$envirom = new("Environment")
$envirom.init()
$envirom.setLevel(2)

$options = new("OptionsMenu")
$options.init()

while true do
    $currentTime = TIME()
    $dt = $currentTime - $lastTime
    $lastTime = $currentTime
    
    $currentTicks = TICKS() 

    # Coordonate de centrare calculate dinamic
    $midX = INT((GL_WIDTH() / 2.0) - 50.0)
    $midY = INT(GL_HEIGHT() / 2.0)

    # 1. Curățare buffer video o SINGURĂ DATĂ la începutul fiecărui cadru
    GL_CLEAR(0x050510) 

    # Hotkey global Fullscreen (F11 = VK 122)
    if KEY_STATE(122) == 1 then
        if ($currentTicks - $lastKeyPressTime) > $inputDelayMs then
            GL_SWITCH_FULLSCREEN()
            $lastKeyPressTime = $currentTicks
        endif
    endif

    # ==========================================
    # STAREA: MENIU PRINCIPAL
    # ==========================================
    if $appState == $STATE_MENU then
        
        # 🔥 PASUL A: Randăm ÎNTÂI fundalul animat cu stele/planete!
        $envirom.update($dt)
        $envirom.render()

        # 🔥 PASUL B: Randăm TOATE textele PESTE fundal!
        GL_TEXT($midX - 30, $midY - 80, "=== OLI-NOVA ===")
        
        $isPaused = 0
        if $gameStarted == 1 then
            if $scene.state == 1 or $scene.state == 4 or $scene.state == 5 then
                $isPaused = 1
            endif
        endif

        if $isPaused == 1 then $lblStart = "CONTINUE" else $lblStart = "START GAME" endif

        if $menuIndex == 0 then $txtStart   = "> " .. $lblStart .. " <" else $txtStart   = "  " .. $lblStart endif
        if $menuIndex == 1 then $txtOptions = "> OPTIONS <"     else $txtOptions = "  OPTIONS" endif
        if $menuIndex == 2 then $txtQuit    = "> QUIT GAME <"   else $txtQuit    = "  QUIT GAME" endif

        GL_TEXT($midX, $midY, $txtStart)
        GL_TEXT($midX, $midY + 40, $txtOptions)
        GL_TEXT($midX, $midY + 80, $txtQuit)

        # Navigare Meniu (Sus / Jos)
        if KEY_STATE(38) == 1 then
            if ($currentTicks - $lastKeyPressTime) > $inputDelayMs then
                $menuIndex = $menuIndex - 1
                if $menuIndex < 0 then $menuIndex = 2 endif
                $lastKeyPressTime = $currentTicks
            endif
        endif

        if KEY_STATE(40) == 1 then
            if ($currentTicks - $lastKeyPressTime) > $inputDelayMs then
                $menuIndex = $menuIndex + 1
                if $menuIndex > 2 then $menuIndex = 0 endif
                $lastKeyPressTime = $currentTicks
            endif
        endif

        # Selectare (Enter = 13)
        if KEY_STATE(13) == 1 then
            if ($currentTicks - $lastKeyPressTime) > $inputDelayMs then
                if $menuIndex == 0 then 
                    $appState = $STATE_GAME 
                    if $isPaused == 0 then
                        $scene.init() 
                        $gameStarted = 1
                    endif
                endif
                if $menuIndex == 1 then $appState = $STATE_OPTIONS endif
                if $menuIndex == 2 then break endif 
                
                $lastKeyPressTime = $currentTicks
            endif
        endif
    endif

    # ==========================================
    # STAREA: JOC (Oli-Nova)
    # ==========================================
    if $appState == $STATE_GAME then
        
        $scene.update($dt)
        $scene.render()

        # Ieșire înapoi la meniu (Escape = 27)
        if KEY_STATE(27) == 1 then
            if ($currentTicks - $lastKeyPressTime) > $inputDelayMs then
                $appState = $STATE_MENU
                $lastKeyPressTime = $currentTicks
            endif
        endif
    endif

    # ==========================================
    # STAREA: OPȚIUNI
    # ==========================================
    if $appState == $STATE_OPTIONS then
        
        $lastKeyPressTime = $options.update($currentTicks, $lastKeyPressTime, $inputDelayMs)
        $options.render($midX, $midY, $envirom, $dt)

        if $options.isBackRequested == 1 then
            $appState = $STATE_MENU
            $options.isBackRequested = 0
        endif

    endif

    $running = GL_PRESENT()
    if $running == 0 then break endif

endwhile

SND_CLOSE()
KBD_RESTORE()
GL_CLOSE()

echo "Oli-Nova închis corect."
exit()