include "src/Entity.oli"

def class Bullet extends Entity { speed, update($dt) }

func Bullet::update($dt)
    if $this.active == 1 then
        $this.y = $this.y + ($this.speed * $dt)
        
        # Marjă de siguranță (+30px) pentru ca graficele/liniile glonțului să părăsească complet ecranul
        $limitY = (GL_HEIGHT() / 2.0) + 30.0
        
        # Dezactivare dinamică la părăsirea ecranului (sus sau jos)
        if $this.y > $limitY then $this.active = 0 endif
        if $this.y < -$limitY then $this.active = 0 endif
    endif
endfunc