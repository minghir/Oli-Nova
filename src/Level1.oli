include "src/Entity.oli"
include "src/Bullet.oli"
include "src/Enemy.oli"
include "src/Player.oli"
include "src/Environment.oli"

def class Level1 { 
    player, enemies, bullets, enemyBullets, env, sndLaser,
    eDir, eSpeed, score, wave, state, fps, enemyShootTimer, isComplete, maxWaves,
    init($player), update($dt, $playerRef), render($playerRef), resetWave()
}

func Level1::init($player)
    $halfH = GL_HEIGHT() / 2.0

    # 1. Poziționare dinamică jucător la marginea de jos
    $player.x = 0
    $player.y = -$halfH + 60.0
    $player.canFire = 1

    # 2. Setare număr maxim de valuri pentru Nivelul 1
    $this.maxWaves = 1

    # 3. Mediul de fundal
    $this.env = new("Environment")
    $this.env.init()
    $this.env.setLevel(1)

    # 4. Încărcare sunet laser
    $this.sndLaser = SND_LOAD("assets/laser_oli.wav")

    # Gloanțe Inamice Pool
    $maxEB = 10
    $tempEB = array(0)
    for $i = 0 to $maxEB - 1 do
        $eb = new("Bullet")
        $eb.active = 0
        $eb.speed = -350
        PUSH($tempEB, $eb)
    endfor
    $this.enemyBullets = $tempEB

    # Gloanțe Player Pool (Maxim 1 glonț activ)
    $maxB = 1
    $tempBullets = array(0)
    for $i = 0 to $maxB - 1 do
        $b = new("Bullet")
        $b.active = 0
        $b.speed = 700
        PUSH($tempBullets, $b)
    endfor
    $this.bullets = $tempBullets

    $this.eDir = 1
    $this.eSpeed = 120
    $this.score = 0
    $this.wave = 1
    $this.state = 1
    $this.isComplete = 0

    $this.fps = 60.0
    $this.enemyShootTimer = 1.0
    $this.resetWave()
endfunc

func Level1::resetWave()
    $halfH = GL_HEIGHT() / 2.0
    $numE = 6
    $tempEnemies = array(0)

    for $i = 0 to $numE - 1 do
        $e = 0
        if $i == 3 then
            $e = new("Boss")
            $e.tex = GL_LOAD_TEXTURE("assets/boss.png")
            $e.w = 80
            $e.h = 80
            $e.angle = 0.0
        else
            $e = new("Enemy")
            $e.tex = GL_LOAD_TEXTURE("assets/small_e.png")
            $e.w = 45
            $e.h = 45
        endif
        $e.x = ($i * 110) - 270
        # Poziționare dinamică în partea de sus a ecranului
        $e.y = $halfH - 120.0
        $e.active = 1
        PUSH($tempEnemies, $e)
    endfor
    $this.enemies = $tempEnemies
endfunc

func Level1::update($dt, $player)
    if $dt > 0 then
        $instantFps = 1.0 / $dt
        $this.fps = $this.fps + ($instantFps - $this.fps) * (5.0 * $dt)
    endif

    $this.env.update($dt)

    if $this.state != 1 then
        if KEY_STATE(82) == 1 then $this.init($player) endif
        return 0
    endif

    $halfW = GL_WIDTH() / 2.0
    $halfH = GL_HEIGHT() / 2.0
    $limitX = $halfW - ($player.w / 2.0)

    # Player & Gloanțe proprii
    $player.update($dt, $limitX)
    $player.shoot($this.bullets, 1, $this.sndLaser)

    cycle $this.bullets as $b do
        if $b != 0 then
            if $b.active == 1 then $b.update($dt) endif
        endif
    endcycle

    # Gloanțe inamice & coliziune cu jucătorul
    cycle $this.enemyBullets as $eb do
        if $eb != 0 then
            if $eb.active == 1 then
                $eb.update($dt)
                if ABS($eb.x - $player.x) < ($player.w / 2.0) then
                    if ABS($eb.y - $player.y) < ($player.h / 2.0) then
                        $eb.active = 0
                        $player.lives = $player.lives - 1
                        if $player.lives <= 0 then $this.state = 2 endif
                    endif
                endif
            endif
        endif
    endcycle

    # LOGICĂ TRAGERE INAMICI
    $this.enemyShootTimer = $this.enemyShootTimer - $dt

    $edgeReached = 0
    $activeEnemies = 0

    cycle $this.enemies as $en do
        if $en != 0 then
            if $en.active == 1 then
                $activeEnemies = $activeEnemies + 1
                $en.move($this.eDir, $this.eSpeed, $dt)

                if ABS($en.x) > $limitX then $edgeReached = 1 endif

                if $this.enemyShootTimer <= 0 then
                    if RANDOM(0, 10) < 3 then
                        cycle $this.enemyBullets as $eb2 do
                            if $eb2.active == 0 then
                                $eb2.active = 1
                                $eb2.x = $en.x
                                $eb2.y = $en.y - 20
                                
                                $delay = 1.4 - ($this.wave * 0.1)
                                if $delay < 0.5 then $delay = 0.5 endif
                                
                                $this.enemyShootTimer = $delay + (RANDOM(0, 40) / 100.0)
                                break
                            endif
                        endcycle
                    endif
                endif

                # Coliziune glonț jucător -> inamic
                cycle $this.bullets as $blt do
                    if $blt != 0 then
                        if $blt.active == 1 then
                            if ABS($blt.x - $en.x) < ($en.w / 2.0) then
                                if ABS($blt.y - $en.y) < ($en.h / 2.0) then
                                    $en.active = 0
                                    $blt.active = 0
                                    $this.score = $this.score + (100 * $this.wave)
                                endif
                            endif
                        endif
                    endif
                endcycle

                # 🔥 Game Over dinamic dacă inamicii coboară prea aproape de jucător
                if $en.y < (-$halfH + 50.0) then $this.state = 2 endif
            endif
        endif
    endcycle

    # Coborâre inamici la atingerea peretelui
    if $edgeReached == 1 then
        $this.eDir = $this.eDir * -1
        cycle $this.enemies as $en2 do 
            if $en2 != 0 then 
                $en2.y = $en2.y - 20 
                if $en2.x > $limitX then $en2.x = $limitX endif
                if $en2.x < -$limitX then $en2.x = -$limitX endif
            endif
        endcycle
    endif

    # Verificare curățare val / progres nivel
    if $activeEnemies == 0 then
        if $this.wave >= $this.maxWaves then 
            $this.isComplete = 1 
        else 
            $this.wave = $this.wave + 1
            $this.eSpeed = $this.eSpeed + 30
            $this.resetWave()
        endif
    endif
endfunc

func Level1::render($player)
    $this.env.render()
    $player.draw()

    $halfW = GL_WIDTH() / 2.0
    $halfH = GL_HEIGHT() / 2.0

    # Factor de scalare dinamic bazat pe rezoluția fizică (raportat la baza 600px)
    $scale = GL_HEIGHT() / 600.0

    # 1. Randare Gloanțe Player
    $pSize = 6.0 * $scale       # Dimensiunea capului laser
    $pLen  = 16.0 * $scale      # Lungimea fasciculului

    cycle $this.bullets as $b do
        if $b != 0 then
            if $b.active == 1 then
                $screenX = $b.x + $halfW
                $screenY = $halfH - $b.y

                GL_POINT($screenX, $screenY, $pSize, 0x00FFFF)
                GL_LINE($screenX, $screenY, $screenX, $screenY + $pLen, 0x00FFFF)
            endif
        endif
    endcycle

    # 2. Randare Gloanțe Inamice
    $eSize = 7.0 * $scale
    $eLen  = 14.0 * $scale

    cycle $this.enemyBullets as $eb do
        if $eb != 0 then
            if $eb.active == 1 then
                $screenX = $eb.x + $halfW
                $screenY = $halfH - $eb.y

                GL_POINT($screenX, $screenY, $eSize, 0xFF2222)
                GL_LINE($screenX, $screenY, $screenX, $screenY - $eLen, 0xFF5555)
            endif
        endif
    endcycle

    # Randare inamici
    cycle $this.enemies as $en do
        if $en != 0 then
            if $en.active == 1 then $en.draw(0.016) endif
        endif
    endcycle
endfunc