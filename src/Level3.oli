include "src/Level1.oli"

def class Level3 extends Level1 {
    init($player), resetWave()
}

func Level3::init($player)
    $halfH = GL_HEIGHT() / 2.0

    # Poziționare dinamică raportată la rezoluție/fullscreen
    $player.x = 0
    $player.y = -$halfH + 60.0
    $player.canFire = 1

    $this.maxWaves = 1

    # Mediul spațial pentru Nivelul 3 (nivelul final)
    $this.env = new("Environment")
    $this.env.init()
    $this.env.setLevel(3)

    # Încărcare o singură dată a sunetului laser
    $this.sndLaser = SND_LOAD("assets/laser_oli.wav")

    # Pool de gloanțe inamice (Foarte rapide pentru Nivelul 3)
    $maxEB = 12
    $tempEB = array(0)
    for $i = 0 to $maxEB - 1 do
        $eb = new("Bullet")
        $eb.active = 0
        $eb.speed = -550
        PUSH($tempEB, $eb)
    endfor
    $this.enemyBullets = $tempEB

    # Pool de gloanțe Player
    $maxB = 1
    $tempBullets = array(0)
    for $i = 0 to $maxB - 1 do
        $b = new("Bullet")
        $b.active = 0
        $b.speed = 700
        PUSH($tempBullets, $b)
    endfor
    $this.bullets = $tempBullets

    $this.eDir = 1
    $this.eSpeed = 210 # Inamici rapizi
    $this.score = 0
    $this.wave = 1
    $this.state = 1
    $this.isComplete = 0

    $this.fps = 60.0
    $this.enemyShootTimer = 0.5
    $this.resetWave()
endfunc

func Level3::resetWave()
    $halfH = GL_HEIGHT() / 2.0
    $numE = 6
    $tempEnemies = array(0)

    # Pre-încărcăm textura o singură dată pentru toți inamicii din val
    $texEnemy3 = GL_LOAD_TEXTURE("assets/small_e3.png")

    for $i = 0 to $numE - 1 do
        $e = new("Enemy")
        $e.tex = $texEnemy3
        $e.w = 45
        $e.h = 45
        
        # Poziționare orizontală centrată și verticală dinamică
        $e.x = ($i * 110) - 270
        $e.y = $halfH - 120.0
        $e.active = 1
        PUSH($tempEnemies, $e)
    endfor
    $this.enemies = $tempEnemies
endfunc