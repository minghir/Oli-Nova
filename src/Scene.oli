include "src/Player.oli"
include "src/Level1.oli"
include "src/Level2.oli"
include "src/Level3.oli"
include "src/Cutscene.oli"

def class Scene {
    player, currentLevel, levelIndex, state, cutscene, init(), update($dt), render(), startNewLevel($lvlNum)
}

func Scene::init()
    $this.player = new("Player")
    $this.player.x = 0
    $this.player.y = 0 
    $this.player.w = 50
    $this.player.h = 50
    $this.player.speed = 320
    $this.player.angle = 0.0
    $this.player.canFire = 1
    $this.player.tex = GL_LOAD_TEXTURE("assets/ship.png")
    $this.player.lives = 3

    $this.levelIndex = 1
    $this.startNewLevel(1)
endfunc

func Scene::startNewLevel($lvlNum)
    if $lvlNum == 1 then
        $this.currentLevel = new("Level1")
    else
        if $lvlNum == 2 then
            $this.currentLevel = new("Level2")
        else
            $this.currentLevel = new("Level3")
        endif
    endif
    
    $this.currentLevel.init($this.player)

    $this.state = 4 
    $this.cutscene = new("Cutscene")
    $this.cutscene.init(1, $this.player)
endfunc

func Scene::update($dt)
    if $this.state == 2 or $this.state == 3 then
        $this.currentLevel.env.update($dt) 

        if KEY_STATE(82) == 1 then
            $this.init() 
        endif
        return 0
    endif

    if $this.state == 4 then
        $this.cutscene.update($dt, $this.player)
        $this.currentLevel.env.update($dt)

        if $this.cutscene.isDone == 1 then
            $this.state = 1
        endif
        return 0
    endif

    if $this.state == 5 then
        $this.cutscene.update($dt, $this.player)
        $this.currentLevel.env.update($dt)

        if $this.cutscene.isDone == 1 then
            $this.levelIndex = $this.levelIndex + 1

            if $this.levelIndex <= 3 then
                $this.startNewLevel($this.levelIndex)
            else
                $this.state = 3 # VICTORIE FINALĂ
            endif
        endif
        return 0
    endif

    if $this.currentLevel.state == 2 then
        $this.state = 2
    else
        $this.currentLevel.update($dt, $this.player)

        if $this.currentLevel.isComplete == 1 then
            $this.currentLevel.isComplete = 0 
            
            $this.state = 5
            $this.cutscene = new("Cutscene")
            $this.cutscene.init(2, $this.player)
        endif
    endif
endfunc

func Scene::render()
    $midX = INT(GL_WIDTH() / 2.0)
    $midY = INT(GL_HEIGHT() / 2.0)

    # 1. Desenăm elementele vizuale
    if $this.state == 4 or $this.state == 5 then
        $this.currentLevel.env.render()
        $this.player.draw()
        $this.cutscene.render()
    else
        if $this.state == 3 then
            # În caz de victorie, nava a plecat: desenăm doar fundalul cu stele/planete
            $this.currentLevel.env.render()
        else
            $this.currentLevel.render($this.player)
        endif
    endif

    # 2. HUD Global
    if $this.state == 1 or $this.state == 2 or $this.state == 3 then
        $scoreVal = $this.currentLevel.score
        $waveVal  = $this.currentLevel.wave
        $livesVal = $this.player.lives
        $fpsVal   = INT($this.currentLevel.fps)

        $dispLevel = $this.levelIndex
        if $dispLevel > 3 then $dispLevel = 3 endif

        GL_TEXT(20, 20, "SCORE: " .. STR($scoreVal) .. "  |  LEVEL: " .. STR($dispLevel) .. " | WAVE: " .. STR($waveVal) .. "  |  LIVES: " .. STR($livesVal) .. "  |  FPS: " .. STR($fpsVal))
    endif

    # 3. Text GAME OVER
    if $this.state == 2 then
        GL_TEXT($midX - 50, $midY - 20, "GAME OVER")
        GL_TEXT($midX - 150, $midY + 20, "Apasa tasta 'R' pentru a relua jocul")
    endif

    # 4. Text VICTORIE (Fără dublu clear, va fi 100% stabil și fără flicker)
    if $this.state == 3 then
        GL_TEXT($midX - 45, $midY - 40, "VICTORY!")
        GL_TEXT($midX - 130, $midY, "Congratulations! You have saved the galaxy!")
    endif
endfunc