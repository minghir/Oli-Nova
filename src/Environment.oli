def class Environment { 
    stars, planetX, planetY, planetSpeed, level, texPlanet, planetAngle, planetR
    init(), update($dt), render(), setLevel($lvl) 
}

@speedMultiply = 18000

func Environment::init()
    # Generare Stele ( Starfield )
    $tempStars = array(0)
    for $i = 0 to 40 do
        $sx = RANDOM(-400, 400)
        $sy = RANDOM(-300, 300)
        $sspeed = RANDOM(50, 200)
        PUSH($tempStars, $sx)
        PUSH($tempStars, $sy)
        PUSH($tempStars, $sspeed)
    endfor
    $this.stars = $tempStars
    
    $this.planetAngle = 0.0
    $this.planetY = 600  
    $this.planetX = RANDOM(-200, 200)
    
    # Generăm dimensiunea
    $this.planetR = RANDOM(60, 300)
    
    # 🔥 Calculăm viteza în funcție de dimensiune (cu o formulă sigură)
    # Dacă planetR e mare, viteza va fi mai mare; dacă e mică, viteza va fi mai mică.
    $this.planetSpeed = @speedMultiply / $this.planetR  # Poți ajusta factorul 0.25 după gust
    
    $this.level = 1
    
    # Încărcăm o textură inițială (default)
    $this.texPlanet = GL_LOAD_TEXTURE("assets/planet1.png")
endfunc

func Environment::setLevel($lvl)
    $this.level = $lvl
    
    # Schimbăm textura planetei în funcție de nivel!
    if $lvl == 1 then
        $this.texPlanet = GL_LOAD_TEXTURE("assets/planet1.png")
    endif
    if $lvl == 2 then
        $this.texPlanet = GL_LOAD_TEXTURE("assets/planet1.png")
    endif
    if $lvl == 3 then
        $this.texPlanet = GL_LOAD_TEXTURE("assets/planet4.png")
    endif
endfunc

func Environment::update($dt)
    # 1. Animație Stele
    $si = 0
    while $si < 120 do
        $this.stars[$si + 1] = $this.stars[$si + 1] - ($this.stars[$si + 2] * $dt)
        if $this.stars[$si + 1] < -300 then
            $this.stars[$si + 1] = 300
            $this.stars[$si] = RANDOM(-400, 400)
        endif
        $si = $si + 3
    endwhile

    # 2. Mișcare lentă a planetei
    $this.planetY = $this.planetY - ($this.planetSpeed * $dt)
    
    # 🔥 Rotire lentă (ex: 5 grade pe secundă)
    $this.planetAngle = $this.planetAngle + (3.0 * $dt)
    
    # Păstrăm unghiul în limite normale (0-360)
    if $this.planetAngle >= 360.0 then
        $this.planetAngle = $this.planetAngle - 360.0
    endif
    
    if $this.planetY < -500 then
        $this.planetY = 500 
        $this.planetX = RANDOM(-250, 250)
        
        # Când apare o planetă nouă, îi dăm un unghi aleatoriu de start
        $this.planetAngle = RANDOM(0, 360) 
		$this.texPlanet = GL_LOAD_TEXTURE("assets/planet"..STR(RANDOM(1,4))..".png")
		$this.planetR = RANDOM(60,300)
		$this.planetSpeed = @speedMultiply / $this.planetR
    endif
endfunc

func Environment::render()
    if $this.level == 1 then
        GL_CLEAR(0x050512)
    else
        GL_CLEAR(0x120505)
    endif

 # C. Randare Stele
    $si = 0
    while $si < 120 do
        $sx = $this.stars[$si] + (GL_WIDTH() / 2)
        $sy = (GL_HEIGHT() / 2) - $this.stars[$si + 1]
        GL_POINT($sx, $sy, 2, 0x7777AA)
        $si = $si + 3
    endwhile

    # 🔥 Pasăm unghiul calculat către GL_DRAW_SPRITE
    if $this.texPlanet != 0 then
        GL_DRAW_SPRITE($this.texPlanet, $this.planetX, $this.planetY, $this.planetR, $this.planetR, $this.planetAngle)
    endif


   
endfunc