def class Environment { 
    stars, planetX, planetY, planetSpeed, level, texPlanet, planetAngle, planetR, planetRotDir, planetTextures,
    init(), update($dt), render(), setLevel($lvl) 
}

@speedMultiply = 18000
@rotMultiply = 2400

func Environment::init()
    $halfW = GL_WIDTH() / 2.0
    $halfH = GL_HEIGHT() / 2.0

    # 1. Pre-încărcăm texturile o singură dată în RAM/VRAM
    $tempTex = array(0)
    PUSH($tempTex, GL_LOAD_TEXTURE("assets/planet1.png"))
    PUSH($tempTex, GL_LOAD_TEXTURE("assets/planet2.png"))
    PUSH($tempTex, GL_LOAD_TEXTURE("assets/planet3.png"))
    PUSH($tempTex, GL_LOAD_TEXTURE("assets/planet4.png"))
    $this.planetTextures = $tempTex

    # 2. Generare Stele pe toată suprafața ecranului curent
    $tempStars = array(0)
    for $i = 0 to 40 do
        $sx = RANDOM(-$halfW, $halfW)
        $sy = RANDOM(-$halfH, $halfH)
        $sspeed = RANDOM(50, 200)
        PUSH($tempStars, $sx)
        PUSH($tempStars, $sy)
        PUSH($tempStars, $sspeed)
    endfor
    $this.stars = $tempStars
    
    $this.planetR = RANDOM(60, 300)
    $this.planetY = $halfH + $this.planetR
    $this.planetX = RANDOM(-($halfW - 100), $halfW - 100)
    $this.planetAngle = 0.0
    $this.planetSpeed = @speedMultiply / $this.planetR
    $this.planetRotDir = RAND_SIGN()
    $this.level = 1
    $this.texPlanet = $this.planetTextures[0]
endfunc

func Environment::setLevel($lvl)
    $this.level = $lvl
    
    if $lvl == 1 then $this.texPlanet = $this.planetTextures[0] endif
    if $lvl == 2 then $this.texPlanet = $this.planetTextures[1] endif
    if $lvl == 3 then $this.texPlanet = $this.planetTextures[3] endif
endfunc

func Environment::update($dt)
    $halfW = GL_WIDTH() / 2.0
    $halfH = GL_HEIGHT() / 2.0

    # 1. Animație Stele (Dinamic raportat la ecran)
    $si = 0
    while $si < 120 do
        $this.stars[$si + 1] = $this.stars[$si + 1] - ($this.stars[$si + 2] * $dt)
        if $this.stars[$si + 1] < -$halfH then
            $this.stars[$si + 1] = $halfH
            $this.stars[$si] = RANDOM(-$halfW, $halfW)
        endif
        $si = $si + 3
    endwhile

    # 2. Mișcare și rotire Planetă
    $this.planetY = $this.planetY - ($this.planetSpeed * $dt)
    $rotSpeed = @rotMultiply / $this.planetR
    $this.planetAngle = $this.planetAngle + ($rotSpeed * $this.planetRotDir * $dt)
    
    # Păstrăm unghiul între 0 și 360 grade
    if $this.planetAngle >= 360.0 then $this.planetAngle = $this.planetAngle - 360.0 endif
    if $this.planetAngle < 0.0 then $this.planetAngle = $this.planetAngle + 360.0 endif
    
    # 3. Resetare planetă dinamic când părăsește ecranul jos
    if $this.planetY < (-$halfH - $this.planetR) then
        $this.planetR = RANDOM(60, 300)
        $this.planetY = $halfH + $this.planetR
        $this.planetX = RANDOM(-($halfW - 100), $halfW - 100)
        $this.planetAngle = RANDOM(0, 360) 
        $this.texPlanet = $this.planetTextures[RANDOM(0, 3)]
        $this.planetSpeed = @speedMultiply / $this.planetR
        $this.planetRotDir = RAND_SIGN()
    endif
endfunc

func Environment::render()

#    if $this.level == 1 then
#        GL_CLEAR(0x050512)
#    else
#        GL_CLEAR(0x120505)
#    endif

    # Randare Stele
    $si = 0
    while $si < 120 do
        $sx = $this.stars[$si] + (GL_WIDTH() / 2.0)
        $sy = (GL_HEIGHT() / 2.0) - $this.stars[$si + 1]
        GL_POINT($sx, $sy, 2, 0x7777AA)
        $si = $si + 3
    endwhile

    # Randare Planetă
    if $this.texPlanet != 0 then
        GL_DRAW_SPRITE($this.texPlanet, $this.planetX, $this.planetY, $this.planetR, $this.planetR, $this.planetAngle)
    endif
endfunc