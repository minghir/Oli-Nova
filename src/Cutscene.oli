def class Cutscene {
    type, duration, timer, startY, targetY, isDone,
    init($sceneType, $player),
    update($dt, $player),
    render()
}

func Cutscene::init($sceneType, $player)
    $this.type = $sceneType # 1 = Intro, 2 = Outro
    $this.timer = 0.0
    $this.isDone = 0

    $halfH = GL_HEIGHT() / 2.0

    if $this.type == 1 then
        # INTRO: Forțăm nava sus de tot în afara ecranului virtual (y = 340) și o coborâm la destinație (-200)
        $player.x = 0.0
        $player.y = $halfH + 40.0
        $this.targetY = -$halfH + 60.0
    else
        # OUTRO: Nava pleacă de unde e și urcă sus de tot în afara ecranului
        $this.targetY = $halfH + 60.0
    endif
endfunc

func Cutscene::update($dt, $player)
    if $this.isDone == 1 then return 0 endif

    $speed = 280.0

    if $this.type == 1 then
        # Animație INTRO: coborâre lină spre poziția de joc
        $player.y = $player.y - ($speed * $dt)
        $player.angle = 0.0

        if $player.y <= $this.targetY then
            $player.y = $this.targetY
            $this.isDone = 1
        endif
    else
        # Animație OUTRO: plecare în viteză spre sus
        $player.y = $player.y + ($speed * 1.8 * $dt)
        $player.angle = 0.0

        if $player.y >= $this.targetY then
            $this.isDone = 1
        endif
    endif
endfunc

func Cutscene::render()
    # Centrare dinamică a textului pe ecranul virtual 800x600
    $midX = INT(GL_WIDTH() / 2.0)
    $midY = INT(GL_HEIGHT() / 2.0)

    if $this.type == 1 then
        GL_TEXT($midX - 90, $midY - 20, "PREPARE FOR BATTLE")
    else
        GL_TEXT($midX - 75, $midY - 20, "SECTOR CLEARED")
    endif
endfunc