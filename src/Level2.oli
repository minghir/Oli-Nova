include "src/Level1.oli"

def class Level2 extends Level1 {
    init($player), resetWave()
}

func Level2::init($player)
    $halfH = GL_HEIGHT() / 2.0

    $this.maxWaves = 1
    $player.x = 0
    $player.y = -$halfH + 60.0
    $player.canFire = 1

    # Nivelul 2 folosește mediul roșiatic
    $this.env = new("Environment")
    $this.env.init()
    $this.env.setLevel(2) 

    $this.sndLaser = SND_LOAD("assets/laser_oli.wav")

    $maxEB = 10
    $tempEB = array(0)
    for $i = 0 to $maxEB - 1 do
        $eb = new("Bullet")
        $eb.active = 0
        $eb.speed = -450
        PUSH($tempEB, $eb)
    endfor
    $this.enemyBullets = $tempEB

    $maxB = 1
    $tempBullets = array(0)
    for $i = 0 to $maxB - 1 do
        $b = new("Bullet")
        $b.active = 0
        $b.speed = 700
        PUSH($tempBullets, $b)
    endfor
    $this.bullets = $tempBullets

    $this.eDir = 1
    $this.eSpeed = 160
    $this.score = 0
    $this.wave = 1
    $this.state = 1
    $this.isComplete = 0

    $this.fps = 60.0
    $this.enemyShootTimer = 0.8
    $this.resetWave()
endfunc

func Level2::resetWave()
    $halfH = GL_HEIGHT() / 2.0
    $numE = 6
    $tempEnemies = array(0)

    # 🔥 Pre-încărcăm textura o singură dată în afara buclei
    $texEnemy2 = GL_LOAD_TEXTURE("assets/small_e2.png")

    for $i = 0 to $numE - 1 do
        $e = new("Enemy")
        $e.tex = $texEnemy2
        $e.w = 45
        $e.h = 45
        
        $e.x = ($i * 110) - 270
        $e.y = $halfH - 120.0
        $e.active = 1
        PUSH($tempEnemies, $e)
    endfor
    $this.enemies = $tempEnemies
endfunc