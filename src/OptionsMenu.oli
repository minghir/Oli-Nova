def class OptionsMenu {
    cfgSound, cfgMusic, cfgVsync, cfgDiff, optIndex,
    isBackRequested,
    init(),
    update($currentTicks, $lastKeyPressTime, $inputDelayMs),
    render($midX, $midY, $menuEnv, $dt)
}

func OptionsMenu::init()
    $this.cfgSound = 1
    $this.cfgMusic = 1
    $this.cfgVsync = 0
    $this.cfgDiff = 1
    $this.optIndex = 0
    $this.isBackRequested = 0
endfunc

func OptionsMenu::update($currentTicks, $lastKeyPressTime, $inputDelayMs)
    $this.isBackRequested = 0
    $newLastKeyTime = $lastKeyPressTime

    # Navigare Sus/Jos
    if KEY_STATE(38) == 1 then
        if ($currentTicks - $newLastKeyTime) > $inputDelayMs then
            $this.optIndex = $this.optIndex - 1
            if $this.optIndex < 0 then $this.optIndex = 4 endif
            $newLastKeyTime = $currentTicks
        endif
    endif

    if KEY_STATE(40) == 1 then
        if ($currentTicks - $newLastKeyTime) > $inputDelayMs then
            $this.optIndex = $this.optIndex + 1
            if $this.optIndex > 4 then $this.optIndex = 0 endif
            $newLastKeyTime = $currentTicks
        endif
    endif

    # Schimbare valori (Enter = 13)
    if KEY_STATE(13) == 1 then
        if ($currentTicks - $newLastKeyTime) > $inputDelayMs then
            
            # 1. SOUND (SFX) ON / OFF
            if $this.optIndex == 0 then 
                $this.cfgSound = 1 - $this.cfgSound 
                # Aici poți lăsa un flag global, ex: @sfxEnabled = $this.cfgSound
				@sfxEnabled = $this.cfgSound
            endif

            # 2. MUSIC ON / OFF (Folosind variabila globală direct!)
            if $this.optIndex == 1 then 
                $this.cfgMusic = 1 - $this.cfgMusic 
                
                if $this.cfgMusic == 1 then
                    SND_SET_VOL(@globalMusicId, 1.0) # Pornește doar muzica
                else
                    SND_SET_VOL(@globalMusicId, 0.0) # Oprește doar muzica
                endif
            endif
            
            if $this.optIndex == 2 then 
                $this.cfgVsync = 1 - $this.cfgVsync
                GL_SET_VSYNC($this.cfgVsync)
            endif
            
            if $this.optIndex == 3 then 
                $this.cfgDiff = $this.cfgDiff + 1
                if $this.cfgDiff > 2 then $this.cfgDiff = 0 endif
            endif

            if $this.optIndex == 4 then 
                $this.isBackRequested = 1
                $this.optIndex = 0 
            endif
            
            $newLastKeyTime = $currentTicks
        endif
    endif

    # Ieșire rapidă cu ESC
    if KEY_STATE(27) == 1 then
        if ($currentTicks - $newLastKeyTime) > $inputDelayMs then
            $this.isBackRequested = 1
            $this.optIndex = 0
            $newLastKeyTime = $currentTicks
        endif
    endif

    return $newLastKeyTime
endfunc

func OptionsMenu::render($midX, $midY, $menuEnv, $dt)
    # Fundalul animat cu stele
    $menuEnv.update($dt)
    $menuEnv.render()

    GL_TEXT($midX - 40, $midY - 80, "=== SETARI JOC ===")

    # 1. Formatare text Sound ON/OFF
    if $this.cfgSound == 1 then
        $strSnd = "ON"
    else
        $strSnd = "OFF"
    endif

    # 2. Formatare text Music ON/OFF
    if $this.cfgMusic == 1 then
        $strMus = "ON"
    else
        $strMus = "OFF"
    endif

    # 3. Formatare text VSync ON/OFF
    if $this.cfgVsync == 1 then
        $strVsync = "ON"
    else
        $strVsync = "OFF"
    endif

    # 4. Formatare text Dificultate (EASY / NORMAL / HARD)
    if $this.cfgDiff == 0 then
        $strDiff = "EASY"
    else
        if $this.cfgDiff == 1 then
            $strDiff = "NORMAL"
        else
            $strDiff = "HARD"
        endif
    endif

    # 5. Generare etichete cu cursor pentru opțiunea selectată
    if $this.optIndex == 0 then
        $lblOpt1 = "> SOUND: " .. $strSnd .. " <"
    else
        $lblOpt1 = "  SOUND: " .. $strSnd
    endif

    if $this.optIndex == 1 then
        $lblOpt2 = "> MUSIC: " .. $strMus .. " <"
    else
        $lblOpt2 = "  MUSIC: " .. $strMus
    endif

    if $this.optIndex == 2 then
        $lblOpt3 = "> VSYNC: " .. $strVsync .. " <"
    else
        $lblOpt3 = "  VSYNC: " .. $strVsync
    endif

    if $this.optIndex == 3 then
        $lblOpt4 = "> DIFF:  " .. $strDiff .. " <"
    else
        $lblOpt4 = "  DIFF:  " .. $strDiff
    endif

    if $this.optIndex == 4 then
        $lblOpt5 = "> BACK <"
    else
        $lblOpt5 = "  BACK"
    endif

    # Randare texte pe ecran
    GL_TEXT($midX - 30, $midY - 20, $lblOpt1)
    GL_TEXT($midX - 30, $midY + 20, $lblOpt2)
    GL_TEXT($midX - 30, $midY + 60, $lblOpt3)
    GL_TEXT($midX - 30, $midY + 100, $lblOpt4)
    GL_TEXT($midX,      $midY + 160, $lblOpt5)
endfunc